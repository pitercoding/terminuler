POSTGRES_DB=terminuler
POSTGRES_USER=terminuler
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://terminuler:change_me@localhost:5433/terminuler

# Optional: HTTP port of the API (default: 8080)
PORT=8080

# Optional: IANA timezone used for business hours (default: UTC)
APP_TIMEZONE=Europe/Berlin

# Optional: appointments a single client may create per minute (default: 5)
APPOINTMENT_RATE_LIMIT=5

# Optional: comma-separated CIDRs or IPs of the proxies allowed to send the client
# IP in X-Real-IP (the Next.js server). Empty by default: the header is ignored and
# every client is identified by its connection address, which behind the proxy is
# the same for all users. Locally, Next.js and the API run on the same machine.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Used only by integration tests: go test -tags=integration ./...
TEST_DATABASE_URL=postgres://terminuler:change_me@localhost:5433/terminuler

# Used to send confirmation email after a successful appointment
RESEND_API_KEY=change_me

# Optional: sender address for confirmation emails (default: onboarding@resend.dev,
# which only delivers to the Resend account owner; use a verified domain in production)
RESEND_FROM_EMAIL=onboarding@resend.dev
